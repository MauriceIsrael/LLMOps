# Copy to .env and fill in. Never commit the filled-in file.
#   cp .env.example .env
#
# Docker Compose reads .env automatically. The Python code does NOT
# (no python-dotenv), so for `poetry run ...` load it into the shell first:
#   set -a; source .env; set +a

# Required: LlamaIndex extraction (pipelines) + DeepEval semantic regression tests.
# Create at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: Discord webhook for high-priority REX and suggestion alerts
# OWNER_NOTIFICATION_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
