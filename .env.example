# LLMOps Environment Variables Configuration
# Copy this file to .env:
#   cp .env.example .env
# Never commit the filled .env file containing real secrets.

# ==============================================================================
# 1. Server Plane, Network & Environment
# ==============================================================================
# Plane to serve: 'knowledge' (read-only base), 'engagement' (client projects), or 'all' (both planes)
LLMOPS_PLANE=all

# Environment mode: 'development', 'demo', or 'production' (in production, fail-closed auth is strictly enforced)
LLMOPS_ENV=development

# Transport protocol: 'stdio' (for CLI / Cursor / Claude Desktop local), or 'sse' (HTTP Starlette for Docker / Cloud Run)
LLMOPS_TRANSPORT=stdio

# Server bind host and port (used when LLMOPS_TRANSPORT=sse)
LLMOPS_HOST=0.0.0.0
PORT=8000

# Graph storage engine: 'ladybug' (default) or 'kuzu'
GRAPH_BACKEND=ladybug

# ==============================================================================
# 2. Authentication & Multi-Tenant Authorization
# ==============================================================================
# Master server administration token for HTTP/SSE access (Bearer or X-API-Key)
SERVER_TOKEN=llmops-dev-secret-token-change-me

# Multi-tenant engagement scoping format: token1:engagementA,engagementB;token2:engagementC;token3:*
# Example for public demo:
# ENGAGEMENT_TOKENS=demo-public-2026-08:nordwave-mcx-2027

# ==============================================================================
# 3. Webhooks & External Services
# ==============================================================================
# Required for extraction pipelines (LlamaIndex) and semantic regression evaluations (DeepEval)
# Obtain at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Discord webhook URL for high-priority architectural feedback (REX) and suggestion notifications
# OWNER_NOTIFICATION_WEBHOOK=https://discord.com/api/webhooks/ID/TOKEN

# Optional GitHub Personal Access Token for release scripts and GitHub API integrations
# GITHUB_TOKEN=ghp_...

# ==============================================================================
# 4. Web Application (apps/kb-client-app)
# ==============================================================================
# Cryptographic secret for JWT signing in SvelteKit web client (min 32 characters in production)
JWT_SECRET=dev-secret-change-me-in-production-min-32-chars!!
