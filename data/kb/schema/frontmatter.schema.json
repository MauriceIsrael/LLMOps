{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture knowledge asset front matter",
  "type": "object",
  "required": [
    "id",
    "title",
    "type",
    "status",
    "confidence",
    "phase",
    "domain",
    "owner",
    "last_reviewed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(P-\\d{3}|ADR-\\d{4}|PAT-\\d{3}|QST-[a-z0-9-]+|EST-[a-z0-9-]+|RSK-[a-z0-9-]+|TPL-[a-z0-9-]+)$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "type": {
      "enum": [
        "principle",
        "decision",
        "pattern",
        "questionnaire",
        "estimate",
        "risk-register",
        "template",
        "project"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "superseded",
        "deprecated",
        "proposed"
      ]
    },
    "confidence": {
      "enum": [
        "verified",
        "designed",
        "vendor-stated",
        "stated-by-client",
        "assumed"
      ]
    },
    "phase": {
      "type": "array",
      "items": {
        "enum": [
          "BID",
          "BUILD",
          "RUN"
        ]
      },
      "minItems": 1
    },
    "domain": {
      "type": "array",
      "items": {
        "enum": [
          "network-automation",
          "observability",
          "cloud-platform",
          "service-management",
          "ai-assistance",
          "security",
          "mobile-core",
          "mcx",
          "transport",
          "delivery",
          "it-infrastructure",
          "it-infrastructure/bare-metal",
          "it-infrastructure/virtualization",
          "it-infrastructure/container-orchestration",
          "it-infrastructure/paas"
        ]
      },
      "minItems": 1
    },
    "owner": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Citable revision of the element (K3): 1 when absent, raised by every accepted amendment. The version-ledger records the content hash of each published revision. Distinct from 'version', which for a control is the revision of the regulatory text."
    },
    "last_reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": "string"
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "applicability": {
      "type": "string"
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keywords used by the doctrine engine to match subjects and options."
    },
    "checks_status": {
      "enum": [
        "draft",
        "partial",
        "validated"
      ],
      "description": "Aggregate of the clauses' own statuses (contract 1.26): 'validated' when every kept clause is validated, 'partial' when some are. Only a human decision on a clause validates it."
    },
    "checks": {
      "type": "array",
      "description": "Structured check clauses evaluated by check_option (deterministic-checks-v1).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "when"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "requires",
              "forbids"
            ]
          },
          "when": {
            "type": "object",
            "properties": {
              "terms_any": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "terms_all": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          },
          "expect": {
            "type": "object",
            "properties": {
              "terms_any": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "terms_all": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          },
          "message": {
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "validated",
              "rejected"
            ],
            "description": "Status of this clause (contract 1.26): only 'validated' blocks an arbitration; 'rejected' is never evaluated. Set by a decision on the clause, never by a promotion."
          },
          "review": {
            "type": "object",
            "description": "Last decision on this clause.",
            "required": [
              "by",
              "at",
              "decision"
            ],
            "properties": {
              "by": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "decision": {
                "enum": [
                  "validate",
                  "amend",
                  "reject"
                ]
              },
              "comment": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "if": {
          "properties": {
            "kind": {
              "const": "requires"
            }
          }
        },
        "then": {
          "required": [
            "expect"
          ]
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      },
      "description": "Hypotheses under which the asset (decision, principle, pattern) holds, one verifiable statement each. A reuse of the asset is confirmed hypothesis by hypothesis (plan similarity, D8)."
    },
    "review_by": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date by which the asset must be reviewed again."
    },
    "source_version": {
      "type": "string",
      "description": "Upstream source version or standard release of the control or framework (Issue #131)."
    },
    "last_verified_at": {
      "type": "string",
      "description": "Date or ISO timestamp at which the control or asset was last verified against the upstream standard (Issue #131)."
    },
    "review_cycle_days": {
      "type": "integer",
      "minimum": 1,
      "description": "Nominal periodicity in days for freshness reviews (Issue #131)."
    },
    "upstream_standard_ref": {
      "type": "string",
      "description": "Citable upstream standard or regulatory reference (e.g. 3GPP TS 33.501 Rel-18, NIS2 Art 21) (Issue #131)."
    }
  },
  "additionalProperties": true
}
