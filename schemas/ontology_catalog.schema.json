{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OntologyCatalog",
  "description": "Schéma formel du catalogue consolidé d'ontologie SI & Telco d'architecture et de gouvernance doctrinale.",
  "type": "object",
  "required": [
    "catalog_version",
    "generated_at",
    "entities",
    "triplets"
  ],
  "additionalProperties": false,
  "properties": {
    "catalog_version": {
      "type": "string",
      "description": "Version du schéma du catalogue d'ontologie (ex: 1.0)."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Horodatage ISO-8601 UTC de génération du catalogue."
    },
    "clause_index": {
      "type": "object",
      "description": "Index de résolution bidirectionnelle entre clauses doctrinales et feuilles d'ontologie.",
      "additionalProperties": false,
      "properties": {
        "by_clause": {
          "type": "object",
          "description": "Dictionnaire associant chaque URN de clause doctrinale aux URNs de feuilles d'ontologie satisfaisant cette clause.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^urn:(archinex|llmops):ontology:[A-Za-z0-9_:-]+$"
            },
            "uniqueItems": true
          }
        },
        "by_leaf": {
          "type": "object",
          "description": "Dictionnaire associant chaque URN de feuille d'ontologie aux URNs de clauses doctrinales la justifiant.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^urn:(archinex|llmops):kb:clause:[A-Za-z0-9_.:-]+$"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "entities": {
      "type": "object",
      "description": "Dictionnaire des entités ontologiques (concepts HLD, sous-axes, feuilles techniques) indexées par leur URN.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "urn",
          "revision",
          "kind",
          "title"
        ],
        "properties": {
          "urn": {
            "type": "string",
            "pattern": "^urn:(archinex|llmops):ontology:[A-Za-z0-9_:-]+$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "concept",
              "axis",
              "leaf"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string"
          },
          "is_default_standard": {
            "type": "boolean"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "oracle_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "governed_by_clauses": {
            "type": "array",
            "description": "Liste d'URNs immuables de clauses doctrinales justifiant formellement la feuille technique.",
            "items": {
              "type": "string",
              "pattern": "^urn:(archinex|llmops):kb:clause:[A-Za-z0-9_.:-]+$"
            },
            "uniqueItems": true
          },
          "hydration_template": {
            "type": "object"
          },
          "projections": {
            "type": "object"
          },
          "togaf_domain": {
            "type": "string",
            "description": "Domaine TOGAF canonique de l'entité (routage des exigences et des emplacements de décision)."
          },
          "document_engine_layer": {
            "type": "string",
            "description": "Couche du Document Engine à laquelle l'entité contribue."
          },
          "default_decision_type": {
            "type": "string",
            "enum": [
              "type1_deliberate",
              "type2_default_ratify"
            ],
            "description": "Traitement par défaut : délibération complète (type 1) ou ratification rapide d'une commodité (type 2)."
          },
          "instantiated_component": {
            "type": "string",
            "description": "Composant logique instancié par la feuille (nom, sans valeur d'instanciation)."
          }
        }
      }
    },
    "triplets": {
      "type": "array",
      "description": "Liste des triplets relationnels formels reliant les concepts, axes, feuilles et clauses doctrinales.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "subject",
          "predicate",
          "object",
          "rationale"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifiant immuable unique du triplet."
          },
          "subject": {
            "type": "string",
            "description": "URN sujet du triplet ontologique.",
            "pattern": "^urn:(archinex|llmops):ontology:[A-Za-z0-9_:-]+$"
          },
          "predicate": {
            "type": "string",
            "description": "Prédicat ontologique formel.",
            "enum": [
              "requires_aspect",
              "implemented_by",
              "depends_on",
              "constrains",
              "conflicts_with",
              "satisfies_clause",
              "requires_prerequisite_axis",
              "instantiates_component"
            ]
          },
          "object": {
            "type": "string",
            "description": "URN objet du triplet ontologique (entité ontologique ou clause doctrinale)."
          },
          "rationale": {
            "type": "string",
            "description": "Explication formelle de la justification ou contrainte ontologique.",
            "minLength": 1
          }
        }
      }
    },
    "enumerations": {
      "type": "object",
      "description": "Énumérations ordonnées portées par le Hub (par exemple le niveau d'isolement d'une zone). Un consommateur compare par rang, jamais par égalité de texte.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordered",
          "values"
        ],
        "properties": {
          "ordered": {
            "type": "boolean",
            "description": "Vrai : les valeurs sont listées de la plus faible à la plus forte."
          },
          "description": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "definition"
              ],
              "properties": {
                "value": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "definition": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "rule_cards": {
      "type": "object",
      "description": "Fiche de chaque règle d'oracle nommée dans `oracle_rules` : ce qu'elle vérifie, sur quel objet, avec quels paramètres, avec quelle preuve. Une règle nommée sans fiche est signalée par `kb ontology catalog-check`.",
      "propertyNames": {
        "pattern": "^data\\.[A-Za-z0-9_.]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object",
          "violation",
          "parameters",
          "evidence_plan",
          "clauses"
        ],
        "properties": {
          "object": {
            "type": "string",
            "minLength": 1,
            "description": "Objet vérifié."
          },
          "violation": {
            "type": "string",
            "minLength": 1,
            "description": "Condition de violation, en une phrase."
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "Noms des paramètres (clés de `projections`) que la règle lit."
          },
          "evidence_plan": {
            "type": "string",
            "minLength": 1,
            "description": "Où la preuve se lit à la planification (inventaire hydraté)."
          },
          "evidence_drift": {
            "type": [
              "string",
              "null"
            ],
            "description": "Où la preuve se lit en dérive (état réel de l'outil en aval) ; null si la règle n'a pas de forme de dérive."
          },
          "clauses": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^urn:archinex:kb:clause:[A-Za-z0-9_:.-]+$"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
