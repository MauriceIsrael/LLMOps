{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ElicitationImportPayload",
  "description": "JSON Schema for third-party elicitation data import into LLMOps.",
  "type": "object",
  "properties": {
    "engagement": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "definition": { "type": "string" },
          "level": {
            "type": "string",
            "enum": ["L0_named", "L1_framed", "L2_decomposed", "L3_decided", "L4_specified"]
          }
        },
        "required": ["name"]
      }
    },
    "statements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "subject": { "type": "string" },
          "predicate": { "type": "string" },
          "value": { "type": "string" },
          "author": { "type": "string" },
          "role": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["verified", "designed", "stated-by-client", "assumed"]
          },
          "verbatim": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["active", "contested", "under_review"]
          }
        },
        "required": ["subject", "value"]
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "detail": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["open", "arbitrated"]
          }
        },
        "required": ["kind", "detail"]
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "subject": { "type": "string" },
          "topic": { "type": "string" },
          "status": { "type": "string" }
        },
        "required": ["topic"]
      }
    }
  },
  "required": ["engagement"]
}
