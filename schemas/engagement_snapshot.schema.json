{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EngagementSnapshot",
  "description": "Sealed snapshot of an engagement emitted by the Knowledge Hub (contract 1.18 (K11), schema 1.1 with decisions at contract 1.19 (K16), 1.2 with imported flags (K12), 1.3 with facts at contract 1.21 (K18)). Suite ExternalSnapshotEnvelope; checksum = sha256 of data at the canonical-json v1 profile; snapshotId derives from the checksum.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.3"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^eng-[a-z0-9-]{1,64}-[0-9a-f]{12}$"
    },
    "sourceSystem": {
      "const": "knowledge-hub"
    },
    "emitter": {
      "const": "knowledge-hub"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRevision": {
      "type": "string"
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "data": {
      "type": "object",
      "properties": {
        "engagement": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,64}$"
            },
            "confidentiality": {
              "enum": [
                "public",
                "internal",
                "confidential"
              ]
            }
          },
          "required": [
            "id",
            "confidentiality"
          ],
          "additionalProperties": false
        },
        "pins": {
          "type": "object",
          "properties": {
            "contract_version": {
              "type": "string"
            },
            "kb_snapshot": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "snapshot_id": {
                      "type": "string"
                    },
                    "checksum": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "snapshot_id",
                    "checksum"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "contract_version",
            "kb_snapshot"
          ],
          "additionalProperties": false
        },
        "is_provisional": {
          "type": "boolean",
          "description": "True when a subject is below L3_decided or a conflict is open: the whole snapshot is then provisional, whatever the status of its items. Derived, never declared."
        },
        "provisional_reasons": {
          "type": "object",
          "properties": {
            "unripe_subjects": {
              "type": "integer",
              "minimum": 0
            },
            "open_conflicts": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "unripe_subjects",
            "open_conflicts"
          ],
          "additionalProperties": false
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "section": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "criticality": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "text",
              "section",
              "category",
              "criticality",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "definition": {
                "type": "string"
              },
              "maturity": {
                "enum": [
                  "L0_named",
                  "L1_framed",
                  "L2_decomposed",
                  "L3_decided",
                  "L4_specified"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "definition",
              "maturity"
            ],
            "additionalProperties": false
          }
        },
        "statements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "section": {
                "type": "string"
              },
              "predicate": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "verified",
                  "designed",
                  "vendor-stated",
                  "stated-by-client",
                  "assumed"
                ]
              },
              "status": {
                "enum": [
                  "proposed",
                  "active",
                  "superseded",
                  "withdrawn"
                ]
              },
              "assertion_level": {
                "enum": [
                  "asserted",
                  "proposed",
                  "superseded",
                  "withdrawn"
                ],
                "description": "Derived from status: only an asserted statement is written as a fact."
              },
              "origin": {
                "enum": [
                  "human",
                  "llm-derived"
                ]
              },
              "author": {
                "type": "string"
              },
              "validated_by": {
                "type": "string",
                "pattern": "^(@[a-z0-9][a-z0-9._-]{0,62})?$"
              },
              "validated_at": {
                "type": "string"
              },
              "based_on": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "resolved": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "resolved"
                  ],
                  "additionalProperties": false
                }
              },
              "imported": {
                "type": "boolean",
                "description": "True when the item was carried over from another system by an import (K12): its author, date and validator are the source's."
              }
            },
            "required": [
              "id",
              "subject",
              "section",
              "predicate",
              "value",
              "confidence",
              "status",
              "assertion_level",
              "origin",
              "author",
              "validated_by",
              "validated_at",
              "based_on",
              "imported"
            ],
            "additionalProperties": false
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "contradiction",
                  "principle_violation",
                  "stale_basis"
                ]
              },
              "status": {
                "type": "string"
              },
              "statement_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "detail": {
                "type": "string"
              },
              "resolution": {
                "type": "string"
              },
              "arbitrated_by": {
                "type": "string",
                "pattern": "^(@[a-z0-9][a-z0-9._-]{0,62})?$"
              }
            },
            "required": [
              "id",
              "kind",
              "status",
              "statement_ids",
              "detail",
              "resolution",
              "arbitrated_by"
            ],
            "additionalProperties": false
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "G1_empty_section",
                  "G2_unanswered_blocking",
                  "G3_principle_unaddressed"
                ]
              },
              "description": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "blocking": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "kind",
              "description",
              "subject",
              "blocking"
            ],
            "additionalProperties": false
          }
        },
        "kb_references": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "statement_id": {
                    "type": "string"
                  },
                  "knowledge_ref": {
                    "type": "object",
                    "properties": {
                      "sourceId": {
                        "const": "knowledge-hub"
                      },
                      "knowledgeKey": {
                        "type": "string"
                      },
                      "version": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "sourceId",
                      "knowledgeKey",
                      "version"
                    ],
                    "additionalProperties": false
                  },
                  "confidence": {
                    "type": "string"
                  }
                },
                "required": [
                  "statement_id",
                  "knowledge_ref",
                  "confidence"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "decision_id": {
                    "type": "string"
                  },
                  "knowledge_ref": {
                    "type": "object",
                    "properties": {
                      "sourceId": {
                        "const": "knowledge-hub"
                      },
                      "knowledgeKey": {
                        "type": "string"
                      },
                      "version": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "sourceId",
                      "knowledgeKey",
                      "version"
                    ],
                    "additionalProperties": false
                  },
                  "confidence": {
                    "type": "string"
                  }
                },
                "required": [
                  "decision_id",
                  "knowledge_ref",
                  "confidence"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "unresolved_references": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "statement_id": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "statement_id",
                  "id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "decision_id": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "decision_id",
                  "id"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "decision": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              },
              "rejected": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "option": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "option",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              },
              "reversibility": {
                "enum": [
                  "reversible",
                  "costly",
                  "irreversible"
                ]
              },
              "consequences": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "accepted_violations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "typed_id": {
                      "type": "string"
                    },
                    "justification": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "typed_id",
                    "justification"
                  ],
                  "additionalProperties": false
                }
              },
              "based_on": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "resolved": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "resolved"
                  ],
                  "additionalProperties": false
                }
              },
              "status": {
                "enum": [
                  "proposed",
                  "active",
                  "superseded",
                  "withdrawn"
                ]
              },
              "assertion_level": {
                "enum": [
                  "asserted",
                  "proposed",
                  "superseded",
                  "withdrawn"
                ],
                "description": "Derived from status: only an asserted decision is written as a decision taken."
              },
              "origin": {
                "enum": [
                  "human",
                  "llm-derived"
                ]
              },
              "author": {
                "type": "string"
              },
              "validated_by": {
                "type": "string",
                "pattern": "^(@[a-z0-9][a-z0-9._-]{0,62})?$"
              },
              "validated_at": {
                "type": "string"
              },
              "supersedes": {
                "type": "string"
              },
              "imported": {
                "type": "boolean",
                "description": "True when the item was carried over from another system by an import (K12): its author, date and validator are the source's."
              },
              "facts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "integer",
                        "boolean",
                        "string"
                      ]
                    },
                    "source_excerpt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "key",
                    "value",
                    "source_excerpt"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "subject",
              "decision",
              "rationale",
              "rejected",
              "reversibility",
              "consequences",
              "accepted_violations",
              "based_on",
              "status",
              "assertion_level",
              "origin",
              "author",
              "validated_by",
              "validated_at",
              "supersedes",
              "imported",
              "facts"
            ],
            "additionalProperties": false
          }
        },
        "facts": {
          "type": "object",
          "properties": {
            "vocabulary": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "integer"
                    },
                    "knowledge_ref": {
                      "type": "object",
                      "properties": {
                        "sourceId": {
                          "const": "knowledge-hub"
                        },
                        "knowledgeKey": {
                          "type": "string"
                        },
                        "version": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "sourceId",
                        "knowledgeKey",
                        "version"
                      ]
                    }
                  },
                  "required": [
                    "version",
                    "knowledge_ref"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "value": {
                    "type": [
                      "integer",
                      "boolean",
                      "string"
                    ]
                  },
                  "source_excerpt": {
                    "type": "string"
                  },
                  "decision": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "unit": {
                    "type": "string"
                  }
                },
                "required": [
                  "key",
                  "value",
                  "source_excerpt",
                  "decision",
                  "subject"
                ],
                "additionalProperties": false
              }
            },
            "contradictions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "decisions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "key",
                  "decisions"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "vocabulary",
            "items",
            "contradictions"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "engagement",
        "pins",
        "is_provisional",
        "provisional_reasons",
        "requirements",
        "subjects",
        "statements",
        "conflicts",
        "gaps",
        "kb_references",
        "unresolved_references",
        "decisions",
        "facts"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "snapshotId",
    "sourceSystem",
    "emitter",
    "createdAt",
    "sourceRevision",
    "checksum",
    "data"
  ],
  "additionalProperties": false
}
