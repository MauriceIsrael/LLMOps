{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProposalSnapshot",
  "description": "Sealed snapshot of proposals a suite application publishes toward the Knowledge Hub (contract 1.33, K7, ADR-KH-01 amendment KH-1). Suite ExternalSnapshotEnvelope; checksum = sha256 of data at the canonical-json v1 profile. The Hub reads it and turns every proposal into a candidate in review; nothing becomes active without a human review. The candidate type is the suite's ExtractedCandidate (destination knowledge-hub-reference), with the proposal in `proposal`. `hub-engagement` is the engagement plane of the Hub itself, capitalising a local rule (K21 point 4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "sourceSystem",
    "createdAt",
    "checksum",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sourceSystem": {
      "enum": [
        "document-studio",
        "architecture-studio",
        "requirements-intake",
        "hub-engagement"
      ]
    },
    "createdAt": {
      "type": "string",
      "minLength": 10
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates"
      ],
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "suggestedDestination",
              "proposal"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "suggestedDestination": {
                "const": "knowledge-hub-reference"
              },
              "sourceFragment": {
                "type": "object"
              },
              "originalText": {
                "type": "string"
              },
              "normalizedText": {
                "type": "string"
              },
              "candidateKind": {
                "type": "string"
              },
              "routingConfidence": {
                "type": "number"
              },
              "verificationModes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "proposal": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "title",
                  "proposed_content"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "new_asset",
                      "amendment",
                      "rex"
                    ]
                  },
                  "asset_type": {
                    "enum": [
                      "principle",
                      "pattern",
                      "decision",
                      "control",
                      "glossary",
                      "trigger",
                      "fact_key"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "rationale": {
                    "type": "string"
                  },
                  "proposed_content": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target_asset_id": {
                    "type": "string"
                  },
                  "domain": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "production_mode": {
                    "enum": [
                      "human-authored",
                      "llm-proposed-human-approved",
                      "llm-derived"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
